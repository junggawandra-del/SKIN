-- Fungsi Utama Menu
function START()
    local menu = gg.choice({
        "1. 🐔 PILOT CHICKEN",
        "2. 🐔 HARLEYQUEEN CHICKEN",
        "3. 🐔 CHEERLEADER CHICKEN",
        "4. 🐔 FAIRYTALE CHICKEN",
        "5. 🐔 BIRTHDAY CHICKEN",
        "6. 🐔 LEPRECHAUN CHICKEN",
        "7. 🐔 CHICKEN IN A CHITON",
        "8. 🐔 FESTIVE CHICKEN",
        "9. 🐔 ASTRO CHICKEN",
        "10. 🐔 DISCO CHICKEN",
        "11. 🐔 KNIGHT CHICKEN",
        "12. 🐔 EXPLORER CHICKEN",
        "13. 🐔 EASTER CHICKEN",
        "❌ EXIT / KELUAR"
    }, nil, 
    "📅 Tanggal: " .. tanggal .. "\n" ..
    "⏰ Jam: " .. jam .. "\n" ..
    "🎮 GAME : TOWNSHIP\n" ..
    "👤 DEV : HANZ\n" ..
    "👕 MENU : SKIN AYAM/CHICKEN")

    -- Logika Penanganan Menu Batal / Klik Luar
    if menu == nil then 
        gg.toast("Script disembunyikan. Klik icon GG untuk membuka kembali.")
    else
        if menu == 1 then MENU1() end
        if menu == 2 then MENU2() end
        if menu == 3 then MENU3() end
        if menu == 4 then MENU4() end
        if menu == 5 then MENU5() end
        if menu == 6 then MENU6() end
        if menu == 7 then MENU7() end
        if menu == 8 then MENU8() end
        if menu == 9 then MENU9() end
        if menu == 10 then MENU10() end
        if menu == 11 then MENU11() end
        if menu == 12 then MENU12() end
        if menu == 13 then MENU13() end
        if menu == 14 then 
            gg.toast("Terima kasih telah menggunakan script HANZ.")
            os.exit() 
        end
    end
end

