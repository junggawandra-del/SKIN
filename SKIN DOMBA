        "13. ✨ MYTICK SHEEP",
        "14. 💃 BALLROOM SHEPP",
        "❌ KELUAR / EXIT"
    }, nil, header)

    if menu == nil then 
        gg.toast("Sembunyi... Klik icon GG untuk kembali")
