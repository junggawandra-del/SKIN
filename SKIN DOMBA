    elseif menu == 6 then L6()
    elseif menu == 7 then L7()
    elseif menu == 8 then L8()
    elseif menu == 9 then L9()
    elseif menu == 10 then L10()
    elseif menu == 11 then L11()
    elseif menu == 12 then L12()
    elseif menu == 13 then L13()
    elseif menu == 14 then L14()
    elseif menu == 15 then EXIT()
    end
end

