function HOME()
    local t = os.date("*t")
    -- Perbaikan bug invalid option %Y dengan mengambil nilai tahun langsung dari tabel t
    local tanggal = string.format("📅 %02d-%02d-%d", t.day, t.month, t.year)
    local jam = string.format("⏰ %02d:%02d:%02d", t.hour, t.min, t.sec)

    local menu = gg.choice({
        "1. 🚢 PIRATE HARBOR",
        "2. 🚢 AQUATORIAL PORT",
        "3. 🚢 SWEET PORT",
        "4. 🚢 DOGE'S PIER",
        "5. 🚢 VIKING HARBOR",
        "6. 🚢 JUNGGLE PORT",
        "7. 🚢 LANTERN HARBOR",
        "8. 🚢 ANCIENT PORT",
        "9. 🚢 EGYPT THEME PORT",
        "10. ❄️ ARTIC PORT",
        "11. ⛩️ JAPANESE PORT",
        "12. ⚔️ KNIGHT PORT",
        "13. 🐰 EASTER PORT",
        "❌ EXIT / KELUAR"
    }, nil, "━━━━━━━━━━━━━━━━━━━━━━\n" .. tanggal .. "\n" .. jam .. "\n━━━━━━━━━━━━━━━━━━━━━━\nGAME : TOWNSHIP\nDEV : HANZ\nMENU : SKIN PELABUHAN/HARBOR\n━━━━━━━━━━━━━━━━━━━━━━")

    if menu == nil then 
        -- Sembunyi jika klik luar
    else
        if menu == 1 then L1() end
        if menu == 2 then L2() end
        if menu == 3 then L3() end
        if menu == 4 then L4() end
        if menu == 5 then L5() end
        if menu == 6 then L6() end
        if menu == 7 then L7() end
        if menu == 8 then L8() end
        if menu == 9 then L9() end
        if menu == 10 then L10() end
        if menu == 11 then L11() end
        if menu == 12 then L12() end
        if menu == 13 then L13() end
        if menu == 14 then os.exit() end
    end
end

