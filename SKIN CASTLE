-- 1. PIRATE SHACK
function L1()
    local items = gg.getListItems()
    local updateList = {}
    for i, v in ipairs(items) do
        local matched = false
        if v.name == "HANZ DATA 1" then v.value = "696B532Ah" matched = true end
        if v.name == "HANZ DATA 2" then v.value = "6F465F6Eh" matched = true end
        if v.name == "HANZ DATA 3" then v.value = "65727472h" matched = true end
        if v.name == "HANZ DATA 4" then v.value = "505F7373h" matched = true end
        if v.name == "HANZ DATA 5" then v.value = "74617269h" matched = true end
        if v.name == "HANZ DATA 6" then v.value = "00003165h" matched = true end
        if v.name == "HANZ NILAI POINTER" then v.value = "0" matched = true end
        if v.name == "HANZ NILAI" then v.value = "2" matched = true end
        
        if matched then v.freeze = true table.insert(updateList, v) end
    end
    gg.setValues(updateList)
    gg.addListItems(updateList)
    gg.toast("✅ PIRATE SHACK UPDATED & FROZEN")
end

