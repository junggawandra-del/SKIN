gg.clearResults()

-- Variabel Waktu & Tanggal Akurat
local tanggal = os.date("%A, %d %B %Y")
local jam = os.date("%H:%M:%S")

-- Efek Loading Keren (Warna-warni & Love)
function Loading()
    gg.toast("⏳ Prepare HANZ PROJECT...")
    gg.sleep(400)
    gg.toast("❤️🧡💛")
    gg.sleep(300)
    gg.toast("💚💙💜")
    gg.sleep(300)
    gg.toast("💖 KERAJAAN/CASTLE MENU LOADED 💖")
end

-- Header Tampilan Atas
local header = [[
📅 ]] .. tanggal .. [[

⏰ ]] .. jam .. [[

━━━━━━━━━━━━━━━━━━━━━━
🎮 GAME : TOWNSHIP
💻 DEV  : HANZ
🏰 MENU : KERAJAAN/CASTLE
━━━━━━━━━━━━━━━━━━━━━━]]

-- Fungsi Utama (Looping agar tidak mudah keluar)
function Main()
    while true do
        if gg.isVisible(true) then
            gg.setVisible(false)
            local menu = gg.choice({
                "1. 🏴‍☠️ PIRATE SHACK",
                "2. ⚓ PIRATE HUB",
                "3. 🚢 PIRATE PORT",
                "4. 🏠 ISLAND HOUSE",
                "5. 🏰 ISLAND MANOR",
                "6. 🏨 ISLAND RESIDENCE",
                "7. 🗼 LITTLE PARIS",
                "8. 🌷 EASTER VILLAGE",
                "9. 🗿 AZTEC ISLAND",
                "❌ KELUAR / EXIT"
            }, nil, header)

            -- Kontrol Menu
            if menu == 1 then L1()
            elseif menu == 2 then L2()
            elseif menu == 3 then L3()
            elseif menu == 4 then L4()
            elseif menu == 5 then L5()
            elseif menu == 6 then L6()
            elseif menu == 7 then L7()
            elseif menu == 8 then L8()
            elseif menu == 9 then L9()
            elseif menu == 10 then os.exit() end
        end
        gg.sleep(100) 
    end
end

